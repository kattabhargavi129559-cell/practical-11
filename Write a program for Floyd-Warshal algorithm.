#include <iostream>
#include <vector>
#include <iomanip>

using namespace std;

// Define Infinity as a large value to represent no edge between vertices.
// Using 1e7 (or a reasonably large number) prevents overflow when adding weights.
const int INF = 1e7; 

void floydWarshall(int V, vector<vector<int>>& graph) {
    // Create a matrix to store the shortest distances initialized with the input graph
    vector<vector<int>> dist = graph;

    // Core Floyd-Warshall logic:
    // Try every vertex 'k' as an intermediate point for all pairs (i, j)
    for (int k = 0; k < V; k++) {
        for (int i = 0; i < V; i++) {
            for (int j = 0; j < V; j++) {
                // If vertex k is on the shortest path from i to j,
                // then update the value of dist[i][j]
                if (dist[i][k] != INF && dist[k][j] != INF && dist[i][k] + dist[k][j] < dist[i][j]) {
                    dist[i][j] = dist[i][k] + dist[k][j];
                }
            }
        }
    }

    // Print the final shortest distance matrix
    cout << "Shortest distance matrix between every pair of vertices:\n";
    for (int i = 0; i < V; i++) {
        for (int j = 0; j < V; j++) {
            if (dist[i][j] == INF) {
                cout << setw(5) << "INF";
            } else {
                cout << setw(5) << dist[i][j];
            }
        }
        cout << "\n";
    }
}

int main() {
    /* Let us create the following weighted graph
            10
       (0)------->(3)
        |         ^
      5 |         | 1
        v         |
       (1)------->(2)
            3           */
    int V = 4;
    vector<vector<int>> graph = {
        {0,   5,   INF, 10},
        {INF, 0,   3,   INF},
        {INF, INF, 0,   1},
        {INF, INF, INF, 0}
    };

    // Run the algorithm
    floydWarshall(V, graph);

    return 0;
}
